# Copy to `.env` (gitignored) and `set -a; source .env; set +a` before release/deploy.

# --- macOS notarization (apps/desktop) ---
# Preferred: a stored xcrun notarytool keychain profile (set up once with xcrun notarytool store-credentials).
APPLE_KEYCHAIN_PROFILE=your-notarytool-profile-name
# Optional: override the default "Developer ID Application" signing identity.
# APPLE_SIGNING_IDENTITY=Developer ID Application: Kesumo, LLC (J372N6RANB)

# --- Windows signing (apps/desktop/signWindows.js) ---
# Set to skip Windows code-signing for a local test build (or drop a
# release/.skip-windows-signing marker file instead).
# SKIP_WINDOWS_SIGN=1

# --- GitHub Releases publish (apps/desktop/publish-github.js) ---
# GH_TOKEN=

# --- Web editor deploy target (apps/web) ---
# scp/ssh destination for `npm run deploy:web`. Set to your own host + webroot.
KBP4_WEB_SSH_SERVER=user@your-host
KBP4_WEB_SSH_LOCATION=/path/to/webroot/products/k-board-pro-4/editor
